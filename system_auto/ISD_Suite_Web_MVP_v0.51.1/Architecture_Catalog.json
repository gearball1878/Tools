{
  "schemaVersion": "isd-architecture-catalog/v1",
  "description": "Tool-neutral catalog for classifying logical electronics domains and architecture-element roles.",
  "naming": {
    "domainPattern": "DOM_<NNN>_<DOMAIN_TYPE_TOKEN>[_<QUALIFIER>]",
    "elementPattern": "AE_<NNN>_<ROLE_TOKEN>[_<QUALIFIER>]",
    "sequenceStart": 10,
    "sequenceStep": 10,
    "allowedCharacters": "A-Z, 0-9 and underscore",
    "displayNameIndependent": true,
    "numbersAreNeverReused": true,
    "manufacturerAndPartNumberForbidden": true
  },
  "partitionRules": [
    {"id": "PR-01", "title": "Hierarchy before taxonomy", "text": "Create a Domain Instance for a meaningful ECAD hierarchy and responsibility boundary, not merely because a technical classification exists."},
    {"id": "PR-02", "title": "One parent, many classifications", "text": "Every Architecture Element has exactly one parent Domain Instance but may carry one primary and multiple secondary technical-domain classifications."},
    {"id": "PR-03", "title": "Strong separation criteria", "text": "Prefer a separate domain for galvanic isolation, independent supply, safety or security independence, separately reusable functions, ownership, variants or clear external interface boundaries."},
    {"id": "PR-04", "title": "Avoid taxonomic collection domains", "text": "Do not collect all clock, memory, connector, power or security elements globally when they are local infrastructure of another functional domain."},
    {"id": "PR-05", "title": "Controlled singleton", "text": "A domain with one AE is justified only by a strong electrical, safety, security, ownership, reuse or variant boundary."},
    {"id": "PR-06", "title": "Shared infrastructure", "text": "Create a shared infrastructure domain only when the function serves several domains and has its own requirements or interface boundary; otherwise place it with its primary consumer."},
    {"id": "PR-07", "title": "Generic architecture", "text": "Architecture Elements describe generic functional hardware roles. Manufacturer parts and orderable components remain implementation bindings."},
    {"id": "PR-08", "title": "Evidence and uncertainty", "text": "If documents do not support a unique partition, create a provisional proposal and record the unresolved boundary as an open question."}
  ],
